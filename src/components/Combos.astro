---
interface Props { intro?: string }
const { intro = 'Each row is one combination of channels: how many people gave on exactly those channels, and what they sent.' } = Astro.props;
---
<h2>Which channels they combine</h2>
<p class="dim">{intro} Tick one or more rows to list those people in the donor list below.</p>
<div class="scroll"><table id="combos"><thead></thead><tbody></tbody></table></div>
