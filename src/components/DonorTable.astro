---
interface Props { everyone?: boolean }
const { everyone = false } = Astro.props;
---
<h2 id="dtitle" data-toc="Donors">Cross-channel donors</h2>
<p class="dim">{everyone ? "Everyone who paid on this channel, biggest givers first. Colored squares mark people who also give on other channels here, and their names link to their own page. " : ""}Each bar splits a person's superchat dollars by channel on one shared scale, with gifted memberships as hatched segments at their estimated price. The Active column shows when they gave, one tick per stream. Click a name for that person's page. Tick people to compare them with everyone else, or switch to hiding them, and shift-click to tick a range. The page link keeps the selection.</p>
<div class="tools">
  {everyone && <button id="dcross" type="button" class="toggle" aria-pressed="false">Cross-channel donors only</button>}
  <span id="ctoggles"></span>
  <input id="q" type="search" placeholder="Find a name" aria-label="Find a name">
  <details class="cols"><summary>Columns</summary><div class="colmenu" id="colmenu"></div></details>
  <button id="onlysel" type="button" class="toggle" aria-pressed="false" hidden>Selected only</button>
  <button id="clearcombo" type="button" hidden></button>
  <span id="count"></span>
  <button id="dcsv" type="button" title="Download the donors listed here, with the current filters">Download CSV</button>
</div>
<div class="scroll"><table id="donors"><thead></thead><tbody></tbody></table></div>
